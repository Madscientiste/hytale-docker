# Hytale server settings
#
# Copy this file to .env (next to docker-compose.yml) and change what you need:
#   cp .env.example .env
# Apply changes with: docker compose up -d
#
# Every value below is the docker-compose.yml default; delete a line or leave it
# as is to keep it.
# .env is in .gitignore, so your passwords are never committed.
#
# Quoting: values are taken literally up to a " #" comment. An empty value must
# not be followed by a comment (the comment would become the value). Wrap a value in
# 'single quotes' when it contains $ or #, and in "double quotes" when it
# contains a single quote.
# Full reference: docs/env-variables.md

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO                # ERROR, WARN, INFO, DEBUG

# --- Server version and updates (docs/update-management.md) ----------------
VERSION=LATEST                # LATEST, or pin a version such as 0.7.7
PATCHLINE=release             # release or pre-release
FORCE_DOWNLOAD=false          # true: download the server files again on the next start
FORCE_UPDATE_CHECK=false      # true: skip the 1-hour update check cooldown

# --- Restarts (docker exec hytale hy-restart works in every mode) ----------
RESTART_MODE=off              # off | schedule (daily at RESTART_TIME) | on-update (when a new version is out)
RESTART_TIME=04:00            # daily restart time for RESTART_MODE=schedule (HH:MM, 24h, time zone TZ)
RESTART_WARN_MINUTES=5        # warn players this many minutes before a restart
RESTART_CHECK_MINUTES=60      # how often RESTART_MODE=on-update looks for a new version (minimum 10)
TZ=UTC                        # container time zone, e.g. Europe/Paris

# --- Server ------------------------------------------------------------------
SERVER_NAME=My Hytale Server
MOTD=Welcome to our Hytale server!
# empty: anyone can join
SERVER_PASSWORD=
MAX_PLAYERS=50
MAX_VIEW_RADIUS=32            # chunks; the main driver of memory use
DEFAULT_WORLD=default
DEFAULT_GAME_MODE=Adventure   # Adventure or Creative

# --- Mods ----------------------------------------------------------------------
# Download links (.jar or .zip), separated by commas. Each is downloaded once into
# data/mods. Files are never deleted: removing a link keeps its file (with a warning).
# Mods you copy into data/mods yourself work too.
MODS=

# --- Recommended plugins (docs/env-variables.md#recommended-plugins) -------------
ENABLE_WEBSERVER=true         # web server on port 5523/tcp, used by the next two
ENABLE_QUERY=true             # server info and player count over HTTP
ENABLE_METRICS=true           # Prometheus metrics
ENABLE_PERFORMANCE_SAVER=true # lowers tick rate and view radius under pressure

# --- Java and startup ----------------------------------------------------------
INIT_MEMORY=8G
MAX_MEMORY=16G
# extra JVM options
JVM_OPTS=
# extra -XX: options
JVM_XX_OPTS=
# empty: all interfaces, port 5520
BIND_ADDRESS=
# empty: QUIC (default)
TRANSPORT_TYPE=
# empty: authenticated (default)
AUTH_MODE=

# --- Backups -------------------------------------------------------------------
ENABLE_BACKUPS=true
BACKUP_DIR=/data/backups      # absolute path inside the container
BACKUP_FREQUENCY=30           # minutes
BACKUP_MAX_COUNT=5

# --- RCON (docs/rcon.md) ---------------------------------------------------------
RCON_ENABLED=true
# empty: the plugin version tested with this image (checksum verified); or latest, or a tag
RCON_VERSION=
RCON_HOST=0.0.0.0             # inside the container; docker-compose.yml publishes the port on 127.0.0.1 only
RCON_PORT=25575
# empty: a random password, made once and saved in data/.rcon-password
RCON_PASSWORD=
# pre-hashed password (overrides RCON_PASSWORD for the plugin)
RCON_PASSWORD_HASH=
RCON_MAX_CONNECTIONS=10
RCON_MAX_FRAME_SIZE=4096
RCON_READ_TIMEOUT_MS=30000
RCON_CONNECTION_TIMEOUT_MS=5000

# --- Login and identity (docs/authentication.md) -----------------------------------
AUTH_REFRESH_HOURS=24         # refresh the Hytale login this often while running
#MACHINE_ID=                  # fixed hardware ID; default: generated once, kept in /data/machine-id

# --- Health check ----------------------------------------------------------------
HEALTH_STARTUP_MINUTES=15     # startup may take this long before the container reports unhealthy
